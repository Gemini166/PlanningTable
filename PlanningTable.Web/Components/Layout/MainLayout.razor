@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject PlannerStore Store
@inject UiService Ui

<div class="app-shell">
    <header class="top-header">
        <div class="header-inner">
            <div class="header-left">
                <div class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                        <rect x="9" y="3" width="6" height="4" rx="1" />
                        <path d="m9 14 2 2 4-4" />
                    </svg>
                </div>
                <div class="brand-text">
                    <h1 class="header-title">@_header.Title</h1>
                    <p class="header-subtitle">@_header.Sub</p>
                </div>
            </div>

            <nav class="top-nav" aria-label="Điều hướng chính">
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                    <span>Du học</span>
                </NavLink>
                <NavLink class="nav-item" href="ielts">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10" /><path d="M18 20V4" /><path d="M6 20v-4" /></svg>
                    <span>IELTS</span>
                </NavLink>
                <NavLink class="nav-item" href="ke-hoach">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><path d="M17.5 14v7M14 17.5h7" /></svg>
                    <span>Kế hoạch mới</span>
                </NavLink>
                <NavLink class="nav-item" href="lich">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    <span>Lịch</span>
                </NavLink>
            </nav>

            <div class="header-actions">
                <button class="icon-btn" type="button" title="Đổi giao diện Sáng/Tối" aria-label="Đổi giao diện Sáng/Tối" @onclick="ToggleTheme">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content" role="main">
        @Body
    </main>
</div>

<Toasts />

<div id="blazor-error-ui" data-nosnippet>
    Đã có lỗi xảy ra.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly Dictionary<string, (string Title, string Sub)> Headers = new()
    {
        [""] = ("Kế hoạch Du học", "Timeline, giấy tờ, trường & dự trù chi phí"),
        ["ielts"] = ("Luyện thi IELTS", "Mục tiêu, chấm điểm thử, so sánh & lịch luyện"),
        ["ke-hoach"] = ("Bảng kế hoạch mới", "Tạo & quản lý thêm các kế hoạch riêng"),
        ["lich"] = ("Lịch tổng hợp", "Xem nhanh mọi hạn chót theo ngày")
    };

    private (string Title, string Sub) _header = Headers[""];
    private string _theme = "light";

    protected override void OnInitialized()
    {
        UpdateHeader();
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _theme = (await Store.GetSettingsAsync()).Theme;
        await Ui.ApplyThemeAsync(_theme);
    }

    private async Task ToggleTheme()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        await Ui.ApplyThemeAsync(_theme);
        await Store.UpdateSettingsAsync(s => s.Theme = _theme);
        Ui.Toast(_theme == "dark" ? "Đã bật giao diện tối" : "Đã bật giao diện sáng");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateHeader();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateHeader()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        _header = Headers.TryGetValue(path, out var h) ? h : Headers[""];
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

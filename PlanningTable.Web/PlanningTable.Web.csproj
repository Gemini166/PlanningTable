<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlanningTable.Web</RootNamespace>
    <!-- Không cần dữ liệu ngôn ngữ ICU → tải trang nhanh hơn, số luôn dùng dấu chấm thập phân -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dữ liệu mẫu ban đầu (trích từ file Excel) được nhúng vào ứng dụng -->
    <None Remove="Data\seed.json" />
    <EmbeddedResource Include="Data\seed.json" LogicalName="PlanningTable.Web.Data.seed.json" />
  </ItemGroup>

</Project>
